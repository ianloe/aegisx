# PostgreSQL database configuration
POSTGRES_USER=aegisx
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=aegisx_governance

# Application database connection string (uses the db service name inside Docker)
DATABASE_URL=postgresql://aegisx:CHANGE_ME_STRONG_POSTGRES_PASSWORD@db:5432/aegisx_governance?schema=public

# Web application port published to the host
APP_PORT=3000

# Secret used to sign HTTP-only session cookies (minimum 32 random characters)
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING

# Set to true only when you want to load the fictional demo dataset
SEED_DEMO_DATA=false

# Initial administrator account created during seed
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Optional evidence upload directory inside the container
UPLOAD_DIR=/app/uploads

# Optional Enterprise SSO (OIDC: Microsoft Entra ID, Okta, Google Workspace)
SSO_ENABLED=false
SSO_PROVIDER_NAME="Enterprise SSO (OIDC)"
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
