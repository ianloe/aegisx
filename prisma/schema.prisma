generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  GOVERNANCE_OFFICE
  ASSET_OWNER
  ASSESSOR
  EXECUTIVE
  AUDITOR
}

enum LifecycleStage {
  IDEA
  PILOT
  PRODUCTION
  RETIRED
}

enum AutonomyLevel {
  ASSISTIVE
  HUMAN_IN_THE_LOOP
  HUMAN_ON_THE_LOOP
  AUTONOMOUS
}

enum DataSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum SourcingType {
  IN_HOUSE
  VENDOR
}

enum AssetType {
  COPILOT
  MODEL
  RAG_ASSISTANT
  AUTONOMOUS_AGENT
  VENDOR_FEATURE
  OTHER
}

enum FrameDimension {
  FOCUS
  ROLES
  AUTHORITY
  METRICS
  EVALUATION
}

enum MetricClassification {
  ACTIVITY
  OUTCOME
  BOTH
  NONE
}

enum AuthorityDecisionType {
  AUTONOMOUS
  HUMAN_CONFIRMED
  OUT_OF_SCOPE
}

enum AppraisalCycleType {
  DAY_30
  DAY_90
  QUARTERLY
  BIANNUAL
}

enum AppraisalStatus {
  SCHEDULED
  DUE
  OVERDUE
  COMPLETED
}

enum AaefDimension {
  TASK_COMPETENCE
  JUDGEMENT_QUALITY
  BOUNDARY_ADHERENCE
  COLLABORATION_EFFECTIVENESS
  IMPROVEMENT_TRAJECTORY
}

enum Trajectory {
  IMPROVING
  STABLE
  DEGRADING
}

enum ProfileCode {
  OPERATIONAL
  DEVELOPING
  RESTRICTED
  UNDER_REVIEW
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskCategory {
  SAFETY
  SECURITY
  PRIVACY
  BIAS_FAIRNESS
  REGULATORY
  OPERATIONAL
  REPUTATIONAL
  THIRD_PARTY
  MODEL_DRIFT
}

enum RiskTreatment {
  MITIGATE
  ACCEPT
  TRANSFER
  AVOID
}

enum RiskStatus {
  OPEN
  MITIGATING
  ACCEPTED
  CLOSED
}

enum ControlEffectiveness {
  EFFECTIVE
  PARTIAL
  INEFFECTIVE
  NOT_TESTED
}

enum MappingCoverage {
  FULL
  PARTIAL
  SUPPORTING
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum CostCategory {
  BUILD
  LICENCE
  INFERENCE_COMPUTE
  PEOPLE
  CHANGE_MANAGEMENT
  GOVERNANCE
}

enum BenefitCategory {
  COST_AVOIDED
  REVENUE_UPLIFT
  PRODUCTIVITY_HOURS
  RISK_REDUCTION
  QUALITY_IMPROVEMENT
}

enum ValueConfidence {
  MEASURED
  ESTIMATED
  ASSUMED
}

enum Currency {
  SGD
  USD
}

enum EvidenceType {
  LINK
  FILE
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

model Organisation {
  id              String         @id @default(cuid())
  name            String
  defaultCurrency Currency       @default(SGD)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  businessUnits   BusinessUnit[]
}

model BusinessUnit {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String       @unique
  name           String
  country        String
  headName       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  assets         AIAsset[]
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String
  users       User[]
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  passwordHash       String
  roleId             String
  role               Role            @relation(fields: [roleId], references: [id])
  businessUnitId     String?
  businessUnit       BusinessUnit?   @relation(fields: [businessUnitId], references: [id])
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  ownedAssets        AIAsset[]       @relation("AssetOwner")
  overseenAssets     AIAsset[]       @relation("AssetOverseer")
  frameAssessments   FrameAssessment[]
  authorityRules     AuthorityRule[]
  appraisalsAssessed AaefAppraisal[] @relation("AppraisalAssessor")
  appraisalsSigned   AaefAppraisal[] @relation("AppraisalSigner")
  breachesReported   BoundaryBreach[]
  risksOwned         Risk[]
  controlsOwned      Control[]
  incidentsReported  Incident[]
  evidenceUploaded   Evidence[]
  actionsOwned       Action[]
  auditLogs          AuditLogEntry[]
  gateRequestsMade   StageGateRequest[] @relation("GateRequester")
  gateReviewsMade    StageGateRequest[] @relation("GateReviewer")
  vendorReviews      VendorAssessment[]
  telemetryApiKeys   TelemetryApiKey[]
}

model AIAsset {
  id                  String           @id @default(cuid())
  assetCode           String           @unique
  name                String
  description         String
  assetType           AssetType        @default(COPILOT)
  businessUnitId      String
  businessUnit        BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  country             String
  ownerId             String?
  owner               User?            @relation("AssetOwner", fields: [ownerId], references: [id])
  overseerId          String?
  overseer            User?            @relation("AssetOverseer", fields: [overseerId], references: [id])
  escalationPath      String?
  rolesLastReviewedAt DateTime?
  lifecycleStage      LifecycleStage   @default(IDEA)
  autonomyLevel       AutonomyLevel    @default(ASSISTIVE)
  dataSensitivity     DataSensitivity  @default(INTERNAL)
  jurisdictions       String[]
  sourcingType            SourcingType      @default(IN_HOUSE)
  vendorName              String?
  isAgent                 Boolean           @default(false)
  runtimeGateStatus       RuntimeGateStatus @default(ALLOW)
  runtimeGateReason       String?
  quarterlyBudgetAmount   Float?
  quarterlyBudgetCurrency Currency          @default(SGD)
  createdAt               DateTime          @default(now())
  updatedAt           DateTime         @updatedAt
  frameAssessments    FrameAssessment[]
  authorityRules      AuthorityRule[]
  aaefAppraisals      AaefAppraisal[]
  boundaryBreaches    BoundaryBreach[]
  risks               Risk[]
  incidents           Incident[]
  costItems           CostItem[]
  benefitItems        BenefitItem[]
  actions             Action[]
  shadowDiscoveries   ShadowAiCandidate[]
  bomComponents       AiBomComponent[]
  dataSources         DataSourceLink[]
  evalScorecards      EvalScorecard[]
  policyExceptions    PolicyException[]
  mcpPolicies         McpServerPolicy[]
  a2aOutboundLinks    A2aPeerLink[]       @relation("A2aSourceAsset")
  a2aInboundLinks     A2aPeerLink[]       @relation("A2aTargetAsset")
  protocolCalls       ProtocolCallEvent[]
  stageGateRequests   StageGateRequest[]
  vendorAssessment    VendorAssessment?
}

model FrameCriterion {
  id            String         @id @default(cuid())
  dimension     FrameDimension
  code          String         @unique
  title         String
  description   String
  rubricJson    Json
  isPlaceholder Boolean        @default(true)
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  scores        FrameScore[]
}

model FrameAssessment {
  id           String       @id @default(cuid())
  assetId      String
  asset        AIAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assessorId   String
  assessor     User         @relation(fields: [assessorId], references: [id])
  assessedAt   DateTime     @default(now())
  status       String       @default("COMPLETED")
  overallScore Float        @default(0)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  scores       FrameScore[]
}

model FrameScore {
  id                   String               @id @default(cuid())
  assessmentId         String
  assessment           FrameAssessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterionId          String
  criterion            FrameCriterion       @relation(fields: [criterionId], references: [id])
  score                Int
  rationale            String
  metricClassification MetricClassification @default(NONE)
  evidenceNote         String?

  @@unique([assessmentId, criterionId])
}

model AuthorityRule {
  id               String                @id @default(cuid())
  assetId          String
  asset            AIAsset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version          Int                   @default(1)
  decisionType     AuthorityDecisionType
  scopeDescription String
  conditions       String?
  effectiveFrom    DateTime              @default(now())
  isActive         Boolean               @default(true)
  createdById      String
  createdBy        User                  @relation(fields: [createdById], references: [id])
  createdAt        DateTime              @default(now())
  boundaryBreaches BoundaryBreach[]
}

model PerformanceProfile {
  id                    String          @id @default(cuid())
  code                  ProfileCode     @unique
  name                  String
  description           String
  governanceConsequence String
  requiredAction        String
  ruleConfigJson        Json
  isPlaceholder         Boolean         @default(true)
  sortOrder             Int             @default(0)
  assignedAppraisals    AaefAppraisal[] @relation("AssignedProfile")
  overriddenAppraisals  AaefAppraisal[] @relation("OverrideProfile")
}

model AaefAppraisal {
  id                 String               @id @default(cuid())
  assetId            String
  asset              AIAsset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cycleType          AppraisalCycleType
  dueDate            DateTime
  completedAt        DateTime?
  assessorId         String?
  assessor           User?                @relation("AppraisalAssessor", fields: [assessorId], references: [id])
  status             AppraisalStatus      @default(SCHEDULED)
  computedTrajectory Trajectory?
  assignedProfileId  String?
  assignedProfile    PerformanceProfile?  @relation("AssignedProfile", fields: [assignedProfileId], references: [id])
  assignmentReason   String?
  overrideProfileId  String?
  overrideProfile    PerformanceProfile?  @relation("OverrideProfile", fields: [overrideProfileId], references: [id])
  overrideReason     String?
  consequenceAction  String?
  signedOffById      String?
  signedOffBy        User?                @relation("AppraisalSigner", fields: [signedOffById], references: [id])
  signedOffAt        DateTime?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  dimensionScores    AaefDimensionScore[]
  boundaryBreaches   BoundaryBreach[]
}

model AaefDimensionScore {
  id             String        @id @default(cuid())
  appraisalId    String
  appraisal      AaefAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  dimension      AaefDimension
  score          Float
  boundaryPassed Boolean?
  rationale      String

  @@unique([appraisalId, dimension])
}

model BoundaryBreach {
  id              String         @id @default(cuid())
  assetId         String
  asset           AIAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  appraisalId     String?
  appraisal       AaefAppraisal? @relation(fields: [appraisalId], references: [id])
  authorityRuleId String?
  authorityRule   AuthorityRule? @relation(fields: [authorityRuleId], references: [id])
  occurredAt      DateTime
  severity        Severity
  description     String
  remediation     String?
  status          String         @default("OPEN")
  reportedById    String
  reportedBy      User           @relation(fields: [reportedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Risk {
  id                 String         @id @default(cuid())
  riskCode           String         @unique
  assetId            String
  asset              AIAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  frameDimension     FrameDimension?
  title              String
  description        String
  category           RiskCategory
  cause              String
  impactDescription  String
  inherentLikelihood Int
  inherentImpact     Int
  residualLikelihood Int
  residualImpact     Int
  financialExposure  Float?
  ownerId            String
  owner              User           @relation(fields: [ownerId], references: [id])
  treatment          RiskTreatment  @default(MITIGATE)
  reviewDate         DateTime
  status             RiskStatus     @default(OPEN)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  controls           RiskControl[]
  incidents          Incident[]
}

model Control {
  id              String               @id @default(cuid())
  controlCode     String               @unique
  title           String
  description     String
  ownerId         String
  owner           User                 @relation(fields: [ownerId], references: [id])
  testFrequency   String               @default("QUARTERLY")
  lastTestedAt    DateTime?
  effectiveness   ControlEffectiveness @default(NOT_TESTED)
  testNotes       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  risks           RiskControl[]
  mappings        ControlMapping[]
}

model RiskControl {
  id        String  @id @default(cuid())
  riskId    String
  risk      Risk    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  controlId String
  control   Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([riskId, controlId])
}

model Framework {
  id           String                 @id @default(cuid())
  code         String                 @unique
  name         String
  version      String
  description  String
  isActive     Boolean                @default(true)
  requirements FrameworkRequirement[]
}

model FrameworkRequirement {
  id          String           @id @default(cuid())
  frameworkId String
  framework   Framework        @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String
  mappings    ControlMapping[]

  @@unique([frameworkId, code])
}

model ControlMapping {
  id            String               @id @default(cuid())
  controlId     String
  control       Control              @relation(fields: [controlId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   FrameworkRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  coverage      MappingCoverage      @default(FULL)
  notes         String?

  @@unique([controlId, requirementId])
}

model Incident {
  id             String         @id @default(cuid())
  incidentCode   String         @unique
  assetId        String
  asset          AIAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  riskId         String?
  risk           Risk?          @relation(fields: [riskId], references: [id])
  title          String
  isNearMiss     Boolean        @default(false)
  occurredAt     DateTime
  severity       Severity
  description    String
  rootCause              String?
  lessonsLearned         String?
  regulatoryFramework    String?
  notificationDueAt      DateTime?
  reportedToRegulatorAt  DateTime?
  status                 IncidentStatus @default(OPEN)
  reportedById   String
  reportedBy     User           @relation(fields: [reportedById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CostItem {
  id          String       @id @default(cuid())
  assetId     String
  asset       AIAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category    CostCategory
  description String
  amount      Float
  currency    Currency     @default(SGD)
  quarter     String
  isRecurring Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BenefitItem {
  id              String          @id @default(cuid())
  assetId         String
  asset           AIAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category        BenefitCategory
  description     String
  plannedAmount   Float
  actualAmount    Float           @default(0)
  currency        Currency        @default(SGD)
  quarter         String
  confidence      ValueConfidence @default(ESTIMATED)
  methodologyNote String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ValueModel {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  description   String
  isPlaceholder Boolean @default(false)
  isActive      Boolean @default(true)
  configJson    Json
}

model Evidence {
  id               String       @id @default(cuid())
  title            String
  type             EvidenceType
  url              String?
  filePath         String?
  originalFilename String?
  mimeType         String?
  fileSize         Int?
  entityType       String
  entityId         String
  uploadedById     String
  uploadedBy       User         @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime     @default(now())

  @@index([entityType, entityId])
}

model Action {
  id          String       @id @default(cuid())
  title       String
  description String?
  assetId     String?
  asset       AIAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])
  dueDate     DateTime
  status      ActionStatus @default(OPEN)
  sourceType  String
  sourceId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GovernanceConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  valueJson   Json
  description String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model AuditLogEntry {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  action      String
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

enum StageGateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorReviewStatus {
  PENDING
  APPROVED
  CONDITIONAL
  REJECTED
}

enum AlertChannel {
  IN_APP
  WEBHOOK
  TELEGRAM
}

model StageGateRequest {
  id                     String          @id @default(cuid())
  assetId                String
  asset                  AIAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedById          String
  requestedBy            User            @relation("GateRequester", fields: [requestedById], references: [id])
  reviewedById           String?
  reviewedBy             User?           @relation("GateReviewer", fields: [reviewedById], references: [id])
  currentLifecycleStage  LifecycleStage
  targetLifecycleStage   LifecycleStage
  currentAutonomyLevel   AutonomyLevel
  targetAutonomyLevel    AutonomyLevel
  status                 StageGateStatus @default(PENDING)
  readinessPassed        Boolean         @default(false)
  readinessSnapshotJson  Json
  justification          String?
  decisionNotes          String?
  reviewedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([assetId, status])
}

model VendorAssessment {
  id                  String             @id @default(cuid())
  assetId             String             @unique
  asset               AIAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendorName          String
  modelName           String?
  modelCardUrl        String?
  dataResidency       String
  zeroDataRetention   Boolean            @default(false)
  subProcessors       String?
  contractRenewalDate DateTime?
  exitPlanSummary     String?
  status              VendorReviewStatus @default(PENDING)
  notes               String?
  reviewerId          String?
  reviewer            User?              @relation(fields: [reviewerId], references: [id])
  lastReviewedAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model TelemetryApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String
  keyHash     String    @unique
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

model AlertRule {
  id             String       @id @default(cuid())
  eventType      String       @unique
  label          String
  description    String
  isEnabled      Boolean      @default(true)
  channel        AlertChannel @default(IN_APP)
  webhookUrl     String?
  telegramChatId String?
  updatedAt      DateTime     @updatedAt
}

model AlertDelivery {
  id         String       @id @default(cuid())
  eventType  String
  title      String
  message    String
  severity   String       @default("INFO")
  entityType String?
  entityId   String?
  channel    AlertChannel @default(IN_APP)
  delivered  Boolean      @default(true)
  isRead     Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@index([isRead, createdAt])
}

enum DiscoverySource {
  SASE
  DNS
  IDP
  CLOUD
  EXPENSE
}

enum DiscoveryStatus {
  DETECTED
  UNDER_REVIEW
  SANCTIONED
  BLOCKED
  DISMISSED
}

model ShadowAiCandidate {
  id             String          @id @default(cuid())
  domain         String
  providerName   String
  category       String          @default("Other AI")
  source         DiscoverySource @default(SASE)
  businessUnit   String          @default("Unassigned")
  requestCount   Int             @default(1)
  bytesUploaded  Float           @default(0)
  uniqueUsers    Int             @default(1)
  status         DiscoveryStatus @default(DETECTED)
  matchedAssetId String?
  matchedAsset   AIAsset?        @relation(fields: [matchedAssetId], references: [id], onDelete: SetNull)
  notes          String?
  firstSeenAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([domain, businessUnit, source])
  @@index([status, lastSeenAt])
}

enum RuntimeGateStatus {
  ALLOW
  RESTRICTED
  SUSPENDED
}

enum BomComponentType {
  MODEL
  PROMPT
  MCP_SERVER
  TOOL_API
  GUARDRAIL
}

enum DataSourceType {
  VECTOR_DB
  DATA_WAREHOUSE
  DOCUMENT_REPO
  CRM_ERP
  API_STREAM
}

enum EvalType {
  RED_TEAM
  HALLUCINATION
  BIAS_FAIRNESS
  PROMPT_INJECTION
  SAFETY_BENCHMARK
}

enum ExceptionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model AiBomComponent {
  id            String           @id @default(cuid())
  assetId       String
  asset         AIAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  componentType BomComponentType
  name          String
  version       String           @default("1.0")
  provider      String?
  isApproved    Boolean          @default(true)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([assetId, componentType])
}

model DataSourceLink {
  id              String          @id @default(cuid())
  assetId         String
  asset           AIAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sourceName      String
  sourceType      DataSourceType
  classification  DataSensitivity @default(INTERNAL)
  piiIncluded     Boolean         @default(false)
  retentionPolicy String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([assetId])
}

model EvalScorecard {
  id          String   @id @default(cuid())
  assetId     String
  asset       AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  suiteName   String
  evalType    EvalType
  passRate    Float
  threshold   Float    @default(85)
  passed      Boolean
  notes       String?
  evaluatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([assetId, evaluatedAt])
}

model PolicyException {
  id                   String          @id @default(cuid())
  assetId              String?
  asset                AIAsset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  title                String
  businessUnit         String
  justification        String
  compensatingControls String
  status               ExceptionStatus @default(ACTIVE)
  expiresAt            DateTime
  approvedBy           String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, expiresAt])
}

model PolicyAttestation {
  id                String   @id @default(cuid())
  policyName        String
  policyVersion     String   @default("2026.1")
  businessUnit      String
  attestedByName    String
  attestedByEmail   String
  trainingCompleted Boolean  @default(true)
  attestedAt        DateTime @default(now())

  @@index([businessUnit, attestedAt])
}

enum ProtocolType {
  MCP
  A2A
}

enum McpToolRiskTier {
  READ_ONLY
  WRITE
  DESTRUCTIVE
}

model McpServerPolicy {
  id           String          @id @default(cuid())
  assetId      String
  asset        AIAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  serverName   String
  endpointUrl  String?
  transport    String          @default("STREAMABLE_HTTP")
  authMode     String          @default("OAUTH2")
  allowedTools String[]
  riskTier     McpToolRiskTier @default(READ_ONLY)
  requiresHitl Boolean         @default(false)
  isApproved   Boolean         @default(true)
  callCount    Int             @default(0)
  lastCalledAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([assetId, serverName])
  @@index([assetId])
}

model A2aPeerLink {
  id              String    @id @default(cuid())
  sourceAssetId   String
  sourceAsset     AIAsset   @relation("A2aSourceAsset", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAssetId   String?
  targetAsset     AIAsset?  @relation("A2aTargetAsset", fields: [targetAssetId], references: [id], onDelete: SetNull)
  targetName      String
  agentCardUrl    String?
  allowedSkills   String[]
  maxHopDepth     Int       @default(2)
  allowPiiSharing Boolean   @default(false)
  isApproved      Boolean   @default(true)
  callCount       Int       @default(0)
  lastCalledAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sourceAssetId])
}

model ProtocolCallEvent {
  id              String       @id @default(cuid())
  protocol        ProtocolType
  sourceAssetId   String
  sourceAsset     AIAsset      @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetName      String
  operation       String
  hopDepth        Int          @default(1)
  traceId         String?
  status          String       @default("OK")
  durationMs      Int?
  violationReason String?
  createdAt       DateTime     @default(now())

  @@index([sourceAssetId, protocol, createdAt])
}
